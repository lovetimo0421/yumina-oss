# Yumina local edition - environment file
#
# Copy this file to `.env` in the repository root. Lines that start with # are
# comments. Every setting is optional except BETTER_AUTH_SECRET.
#
# Model API keys (OpenRouter, Anthropic, OpenAI, Google, ...) do NOT go in this
# file. Add them in Settings inside the app. They are stored in your local
# database, encrypted.

# Which edition this build is. The open-source build is always "local".
# Leave it alone.
YUMINA_EDITION=local

# Secret used to sign your session cookie and to derive the key that encrypts
# the model API keys you save in Settings. Make a real one with:
#     openssl rand -hex 32
# If you change it later, every saved API key becomes unreadable and you will
# have to enter them again. Keep this file private.
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32

# Port the server listens on. The app opens at http://localhost:<PORT>.
PORT=3000

# Address the server binds to. 127.0.0.1 means only this computer can reach it.
# Single-user mode has no login, so anyone who can reach the port is "you".
# Set 0.0.0.0 only on a network you trust, or switch YUMINA_AUTH_MODE to
# multi-user first.
HOST=127.0.0.1

# single-user (default): one local account, no login screen.
# multi-user: a login screen with email and password. Use this if other people
# will share this install or you expose it beyond your own machine.
# YUMINA_AUTH_MODE=single-user

# Folder where everything is saved: the embedded database plus uploaded images
# and audio. A relative path is resolved from packages/server, so the default
# is packages/server/data. Back up this folder and you have backed up Yumina.
# YUMINA_DATA_DIR=./data

# Folder for uploaded images and audio, only if you want them somewhere other
# than <YUMINA_DATA_DIR>/assets.
# YUMINA_STORAGE_DIR=./data/assets

# The URL people use to reach this install, for example
# https://yumina.example.com. Set it when you run Yumina behind a domain or a
# reverse proxy so cookies, CORS, and links match. Default: http://localhost:3000
# PUBLIC_ORIGIN=http://localhost:3000

# Use a real PostgreSQL server instead of the embedded one. Leave unset to keep
# the embedded database (PGlite) in <YUMINA_DATA_DIR>/pglite. The server sets
# up its tables on first start.
# DATABASE_URL=postgresql://user:password@localhost:5432/yumina

# S3-compatible storage for uploads (AWS S3, Cloudflare R2, MinIO, ...). Leave
# all five unset to keep uploads on local disk. Set all five to use a bucket.
# AWS_S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL=https://s3.amazonaws.com
# AWS_DEFAULT_REGION=us-east-1

# Social logins. Only used when YUMINA_AUTH_MODE=multi-user. Leave a pair unset
# and its button does not appear. Each provider needs an OAuth app whose
# callback URL is <PUBLIC_ORIGIN>/api/auth/callback/<provider>.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
